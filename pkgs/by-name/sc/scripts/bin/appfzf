#!/usr/bin/env bash

shopt -s nullglob

apps=(~/Applications/*.app ~/Applications/*/*.app /Applications/*.app /Applications/*/*.app /System/Applications/*.app /System/Applications/*/*.app /run/current-system/sw/bin/*)
apps=("${apps[@]%.app}")

app=$(printf '%s\n' "${apps[@]}" | fzf --no-separator --history="$HOME/.cache/appfzf" --reverse --no-info --delimiter='/' --with-nth=-1 "$@")

[[ -n $app ]] || exit 0

if [[ $app == "/run/current-system/sw/bin/"* ]]; then
  daemon "$app"
else
  open -n -a "$app.app"
fi
